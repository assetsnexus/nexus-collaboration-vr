# Copy keys into the playground Settings UI (localStorage) — never commit `.env.local`.

# Optional Vite env for defaults:
# VITE_LLM_API_KEY=
# VITE_OPENROUTER_API_KEY=
# VITE_SPEACHES_URL=http://127.0.0.1:8090
# LLM_PROXY_TARGET=http://127.0.0.1:8080

# Compact [nod,2s,wave] motion tags (default true). Set 0/false/off to disable.
# VITE_INLINE_CHARACTER_TAGS=true
# Show stripped tags as chat badges
# VITE_DEBUG_CHARACTER_TAGS=false
