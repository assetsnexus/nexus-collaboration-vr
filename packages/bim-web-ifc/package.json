{
  "name": "@nexus/bim-web-ifc",
  "version": "0.0.1",
  "description": "web-ifc adapter for the cluster-editor-core BimKernel seam",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test src/web-ifc-kernel.test.ts"
  },
  "dependencies": {
    "@nexus/cluster-editor-core": "workspace:*",
    "web-ifc": "^0.0.69"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
