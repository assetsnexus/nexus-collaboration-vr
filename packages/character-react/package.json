{
  "name": "@nexus/character-react",
  "version": "0.1.0",
  "description": "React bindings for @nexus/character-kit (CompanionHost, SceneRoom, avatar studio)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "three": ">=0.160.0",
    "@nexus/character-kit": "workspace:*",
    "@nexus/character-ui-kit": "workspace:*"
  },
  "devDependencies": {
    "@nexus/character-kit": "workspace:*",
    "@nexus/character-ui-kit": "workspace:*",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.180.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.180.0",
    "typescript": "^5.9.2"
  }
}
