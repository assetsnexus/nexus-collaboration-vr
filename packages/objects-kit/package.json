{
  "name": "@nexus/objects-kit",
  "version": "0.1.0",
  "description": "Primitive + glTF scene objects, effect clips, load billboards, and object_* tools",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": ["src"],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test src/spec.test.ts src/url-policy.test.ts src/effects.test.ts src/furniture.test.ts"
  },
  "peerDependencies": {
    "three": ">=0.160.0",
    "@nexus/scene-kit": "workspace:*"
  },
  "devDependencies": {
    "@nexus/scene-kit": "workspace:*",
    "@types/three": "^0.180.0",
    "three": "^0.180.0",
    "typescript": "^5.9.2"
  }
}
